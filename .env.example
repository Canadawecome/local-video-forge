# Separate API billing, unrelated to ChatGPT subscription
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPUSCLIP_API_KEY=
ELEVENLABS_API_KEY=
# GPT-5.6 Sol supports text/image inputs; do not pass MP4/audio directly
SOURCE_INGEST_MODE=METADATA_ONLY
ENABLE_AUTHORIZED_ORIGINAL_DOWNLOAD=false
MAX_FRAMES_PER_CLIP=45
MAX_OPENAI_CONCURRENCY=2
MAX_PROVIDER_SPEND_USD=10
