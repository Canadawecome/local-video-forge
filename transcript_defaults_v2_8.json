{
  "transcript_engine": "opus_first",
  "priority": [
    "opus_clip_srt",
    "opus_clip_timed_json",
    "opus_project_verified_edit_map",
    "local_faster_whisper_fallback"
  ],
  "asr_on_every_clip": false,
  "asr_fallback_only_on_invalid_or_missing_clip_transcript": true,
  "fallback_asr": "faster_whisper",
  "alignment_if_needed": "whisperx_optional",
  "source_language": "de",
  "clip_timestamp_unit": "seconds",
  "source_to_clip_time_map_required": true,
  "audio_mode": "SPEECH_STEM_REPLACEMENT",
  "audio_separator_preference": ["sam_audio_local", "audioshake_api_if_allowed"],
  "fallback_if_separator_fails": "NEEDS_AUDIO_REVIEW",
  "legacy_deep_duck_is_not_speech_removal": true,
  "protected_asmr_required": true,
  "one_clip_one_script_one_voice_one_folder": true
}
